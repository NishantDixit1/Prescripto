# Copy to .env and fill in real values. Never commit the real .env.

# Server
PORT=4000

# MongoDB connection string (WITHOUT trailing /prescripto — code appends the db name)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Admin panel login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=set_a_strong_password

# Cloudinary (image uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# Payments (optional — server now boots without these, but payment routes need them)
CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
